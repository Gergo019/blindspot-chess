# Copy to .env and adjust. Docker Compose reads .env automatically.

POSTGRES_DB=blindspot
POSTGRES_USER=blindspot
POSTGRES_PASSWORD=blindspot
POSTGRES_PORT=5432

BACKEND_PORT=8080
ANALYSIS_SERVICE_PORT=8000

# How long the backend waits for one game's analysis (a long game at depth 16
# takes minutes). Spring duration format, e.g. 180s or 5m.
ANALYSIS_SERVICE_READ_TIMEOUT=180s

# Stockfish settings for the analysis service. Keep ENGINE_THREADS=1:
# multi-threaded search is not deterministic, so results would not be
# reproducible. Changing depth or hash changes the evaluations; every
# response reports the engine version and depth it used.
ENGINE_DEPTH=16
ENGINE_THREADS=1
ENGINE_HASH_MB=64
# STOCKFISH_PATH is set inside the Docker image (/usr/local/bin/stockfish);
# set it only when running the service outside Docker.

# Lichess import. LICHESS_USERNAME is the account whose recent completed rapid
# games are imported (until there is sign-up); leave it empty to import nothing.
# Each run fetches the newest LICHESS_IMPORT_BATCH_SIZE games and skips any
# already stored; runs repeat every LICHESS_IMPORT_INTERVAL.
LICHESS_USERNAME=
LICHESS_IMPORT_BATCH_SIZE=20
LICHESS_IMPORT_INTERVAL=1h
# Optional: a personal Lichess token (https://lichess.org/account/oauth/token)
# raises the API rate limit for game imports. Public games work without it.
LICHESS_API_TOKEN=

# Needed from Phase 4 (AI explanations) onwards.
LLM_API_KEY=
