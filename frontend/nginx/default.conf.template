# Serves the built app and proxies /api to the backend (ADR 0007, #50).
# Rendered at container start by the image's entrypoint (envsubst), which only replaces variables
# that are set in the environment: ${BACKEND_ORIGIN}. nginx's own $variables are left alone.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # No nginx version in the Server header or on error pages.
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    # Liveness for the Compose healthcheck: answered by nginx itself, independent of the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The backend's name is resolved per request through Docker's DNS, so nginx starts even when the
    # backend is not up yet (or not running at all); /api then answers 502 until it is.
    location /api/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        resolver_timeout 2s;
        set $backend ${BACKEND_ORIGIN};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets never change under the same name.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths get index.html, which must never be cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
