# Copy to .env and adjust. Docker Compose reads .env automatically.

POSTGRES_DB=blindspot
POSTGRES_USER=blindspot
POSTGRES_PASSWORD=blindspot
POSTGRES_PORT=5432

BACKEND_PORT=8080

# demo: on first start, load about 20 real rapid games from the Lichess open
# database (2013-01, CC0) for the user "demo"; the background analysis then
# finds their mistakes. No Lichess account needed. The demo profile switches
# the live Lichess import off; leave this empty to import your own games
# (LICHESS_USERNAME below).
SPRING_PROFILES_ACTIVE=demo
# The web app (nginx); it proxies /api to the backend.
FRONTEND_PORT=8081

# How long the backend waits for one game's analysis. Measured at depth 16:
# 105-165 ms per half-move, about 50 s for the longest accepted game (300
# half-moves); 180s leaves room for slower machines. Spring duration format.
ANALYSIS_SERVICE_READ_TIMEOUT=180s

# Background analysis of imported games. ANALYSIS_WORKERS games are analysed
# at a time (each is one single-threaded Stockfish in the analysis service);
# each run takes the ANALYSIS_BATCH_SIZE newest PENDING games. A game RUNNING
# longer than ANALYSIS_STUCK_AFTER (crash or restart) goes back to PENDING
# once, then FAILED; it must be longer than the read timeout.
ANALYSIS_WORKERS=1
ANALYSIS_BATCH_SIZE=10
ANALYSIS_INTERVAL=30s
ANALYSIS_STUCK_AFTER=30m

# Drill preparation (#36): the backend turns findings into "Find a safe move"
# drills in the background, one POST /judge per finding (each up to the
# analysis service's JUDGE_BUDGET_SECONDS). Each run takes the
# DRILL_PREPARATION_BATCH_SIZE newest findings without a drill; runs repeat
# every DRILL_PREPARATION_INTERVAL. A finding whose judging exceeded the time
# budget, timed out or could not be stored is retried after
# DRILL_PREPARATION_RETRY_AFTER; nothing of the failed attempt is stored.
DRILL_PREPARATION_BATCH_SIZE=5
DRILL_PREPARATION_INTERVAL=60s
DRILL_PREPARATION_RETRY_AFTER=1h

# Stockfish settings for the analysis service. Keep ENGINE_THREADS=1:
# multi-threaded search is not deterministic, so results would not be
# reproducible. Changing depth or hash changes the evaluations; every
# response and stored evaluation records the engine version, depth, threads
# and hash size it used.
ENGINE_DEPTH=16
ENGINE_THREADS=1
ENGINE_HASH_MB=64
# Wall-clock budget in seconds for one POST /judge request (all legal moves of
# one drill position, #78). The budget never shortens a search: a position that
# needs longer fails with no verdicts. The default comes from measuring the demo
# positions (devlog, #78); raise it only if a slower machine needs it.
JUDGE_BUDGET_SECONDS=60
# STOCKFISH_PATH is set inside the Docker image (/usr/local/bin/stockfish);
# set it only when running the service outside Docker.

# Lichess import. LICHESS_USERNAME is the account whose recent completed rapid
# games are imported (until there is sign-up); leave it empty to import nothing.
# Each run fetches the newest LICHESS_IMPORT_BATCH_SIZE games and skips any
# already stored; runs repeat every LICHESS_IMPORT_INTERVAL.
LICHESS_USERNAME=
LICHESS_IMPORT_BATCH_SIZE=20
LICHESS_IMPORT_INTERVAL=1h
# Optional: a personal Lichess token (https://lichess.org/account/oauth/token)
# raises the API rate limit for game imports. Public games work without it.
LICHESS_API_TOKEN=

# Needed from Phase 4 (AI explanations) onwards.
LLM_API_KEY=
